# =============================================
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env a GitHub
# =============================================

# URI de conexion a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (por defecto: softwell)
MONGODB_DATABASE=softwell
